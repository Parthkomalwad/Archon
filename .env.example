# Archon environment variables  add these to your existing .env file

# API key to authenticate all REST API calls to Archon
# Generate with: openssl rand -hex 32
ARCHON_API_KEY=your-random-secret-string-here

# 32-byte AES-256 encryption key for backup files
# Generate with: openssl rand -base64 32
# WARNING: losing this key makes existing encrypted backups unrecoverable
ENCRYPTION_KEY=your-base64-encoded-32-byte-key

# Your database credentials (already in your .env  referenced in config.yaml)
DB_USER=myuser
DB_PASSWORD=mypassword

# MongoDB credentials (if using MongoDB)
MONGO_USER=mongoadmin
MONGO_PASSWORD=mongopassword

# AWS S3 credentials (if using S3 storage)
AWS_ACCESS_KEY=your-aws-access-key
AWS_SECRET_KEY=your-aws-secret-key

# Azure Blob Storage (if using Azure storage)
AZURE_STORAGE_CONN_STR=DefaultEndpointsProtocol=https;AccountName=...
